<?xml version="1.0" encoding="utf-8"?>
<!-- Local-only NuGet config for building this plugin against the Jellyfin source tree at /root/jellyfin. Pack the Jellyfin projects into /tmp/jellyfin-local-nuget first via build-local.sh, then: dotnet restore configfile nuget.local.config -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-jellyfin" value="/tmp/jellyfin-local-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
